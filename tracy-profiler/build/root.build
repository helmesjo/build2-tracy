# Uncomment to suppress warnings coming from external libraries.
#
cxx.internal.scope = current

# Apple SDK headers (included through GLFW's native access header) currently
# reject the C++26 arithmetic between different enumeration types.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Upstream uses sprintf(), which the macOS SDK marks as deprecated.
#
if ($cxx.target.class == 'macos')
  cxx.coptions += -Wno-deprecated-declarations

# Project-wide Windows definitions, as set by upstream's cmake/config.cmake.
#
if ($cxx.target.class == 'windows')
  cxx.poptions += -DNOMINMAX -DWIN32_LEAN_AND_MEAN \
                  -D_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR

using in

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
