intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
#import xxxx_libs += libhello%lib{hello}

lib{tracy-client}: {hxx ixx txx cxx}{**} $impl_libs $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/public/
src_pfx = [dir_path] $src_root/public/

cxx.poptions =+ "-I$out_pfx" "-I$src_pfx"

#obja{*}: cxx.poptions += -DTRACY_STATIC_BUILD
#objs{*}: cxx.poptions += -DTRACY_SHARED_BUILD

# Export options.
#
lib{tracy-client}:
{
  cxx.export.poptions = "-I$out_pfx" "-I$src_pfx"
  cxx.export.libs = $intf_libs
}

#liba{tracy-client}: cxx.export.poptions += -DTRACY_STATIC
#libs{tracy-client}: cxx.export.poptions += -DTRACY_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{tracy-client}: bin.lib.version = "-$version.project_id"
else
  lib{tracy-client}: bin.lib.version = "-$version.major.$version.minor"

# Install recreating subdirectories.
#
{hxx ixx txx}{*}:
{
  install         = include/
  install.subdirs = true
}
