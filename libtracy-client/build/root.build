# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Upstream uses sprintf(), which the macOS SDK marks as deprecated.
#
if ($cxx.target.class == 'macos')
  cxx.coptions += -Wno-deprecated-declarations

# Enable the profiler (TRACY_ENABLE). If false, the instrumentation macros
# expand to nothing and the library is essentially empty.
#
config [bool] config.libtracy_client.enable ?= true

# Only collect profiling data while a server is connected (TRACY_ON_DEMAND).
#
config [bool] config.libtracy_client.on_demand ?= false

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
